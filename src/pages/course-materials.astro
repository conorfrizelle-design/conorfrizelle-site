---
import Base from '../layouts/Base.astro';

const courses = [
  {
    code: "18.100B",
    title: "Real Analysis",
    notes: [
      {
        title: "Lecture 1 Notes",
        description: "Real Numbers",
        date: "7/11/26",
        pdf: "/Notes/Real-Analysis/Lecture-1-Notes.pdf",
      },
      {
        title: "Lecture 2 Notes",
        description: "Real Numbers Ctd.",
        date: "7/11/26",
        pdf: "/Notes/Real-Analysis/Lecture-2-Notes.pdf",
      },
      {
        title: "Lecture 3 Notes",
        description: "Proofs",
        date: "7/12/26",
        pdf: "/Notes/Real-Analysis/Lecture-3-Notes.pdf",
      },
      {
        title: "Lecture 4 Notes",
        description: "Sequences",
        date: "7/24/26",
        pdf: "/Notes/Real-Analysis/Lecture-4-Notes.pdf",
      },
      {
        title: "Lecture 5 Notes",
        description: "Monotone Convergence Theorem",
        date: "7/24/26",
        pdf: "/Notes/Real-Analysis/Lecture-5-Notes.pdf",
      },
      {
        title: "Lecture 6 Notes",
        description: "Cauchy Convergence Theorem",
        date: "8/5/26",
        pdf: "/Notes/Real-Analysis/Lecture-6-Notes.pdf",
      },
      {
        title: "Lecture 7 Notes",
        description: "Bolzano-Weirstrass Theorem; Series",
        date: "8/6/26",
        pdf: "/Notes/Real-Analysis/Lecture-7-Notes.pdf",
      },
      {
        title: "Lecture 8 Notes",
        description: "Convergence Tests & Power Series",
        date: "8/7/26",
        pdf: "/Notes/Real-Analysis/Lecture-8-Notes.pdf",
      },
      {
        title: "Lecture 9 Notes",
        description: "Limsup, Liminf; Power Series (Cont); Continuous Functions; Exponential Function",
        date: "8/8/26",
        pdf: "/Notes/Real-Analysis/Lecture-9-Notes.pdf",
      },
      {
        title: "Lecture 10 Notes",
        description: "Continuous Functions; Exponential Function (Cont)",
        date: "8/9/26",
        pdf: "/Notes/Real-Analysis/Lecture-10-Notes.pdf",
      },
      {
        title: "Lecture 11 Notes",
        description: "Extreme & Intermediate Value Theorem; Metric Spaces",
        date: "8/10/26",
        pdf: "/Notes/Real-Analysis/Lecture-11-Notes.pdf",
      },
    ],
